# EventFlow

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://eventflow:eventflow@localhost:5435/eventflow

# One active transport per deployment: rabbitmq | kafka
MESSAGING_TRANSPORT=rabbitmq

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_EVENTS=eventflow.events
RABBITMQ_EXCHANGE_DLX=eventflow.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT=30
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_EVENTS=eventflow.events
KAFKA_TOPIC_RETRY=eventflow.events.retry
KAFKA_TOPIC_DLT=eventflow.events.dlt
KAFKA_PRODUCER_IDEMPOTENT=false

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
